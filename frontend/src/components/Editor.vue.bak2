<template>
  <div class="editor-container">
    <!-- Global Aurora Background -->
    <div class="aurora-bg-layer">
      <div class="aurora-glow aurora-glow-1"></div>
      <div class="aurora-glow aurora-glow-2"></div>
      <div class="aurora-glow aurora-glow-3"></div>
    </div>

    <!-- 顶部导航栏 -->
    <header class="editor-header">
      <button class="nav-button back-button" @click="handleCancel" :aria-label="t('editor.back')">
        <ArrowLeft class="nav-icon" />
        <span class="nav-text">{{ t('editor.back') }}</span>
      </button>

      <div class="header-center">
        <div class="page-indicator" :class="currentNoteType">
          <Sparkles v-if="currentNoteType === 'quick'" class="indicator-icon" />
          <FileText v-else class="indicator-icon" />
          <span class="page-title">
            {{ props.mode === 'create' ? (currentNoteType === 'article' ? t('editor.newArticle') : t('editor.newNote')) : (currentNoteType === 'article' ? '编辑文章' : '编辑灵感小记') }}
          </span>
        </div>
        
        <!-- 类型切换器（仅创建模式） -->
        <transition name="type-switch">
          <div v-if="showTypeSelector && props.mode === 'create'" class="type-switcher">
            <button
              type="button"
              class="type-option"
              :class="{ active: currentNoteType === 'quick' }"
              @click="switchNoteType('quick')"
              :aria-label="t('editor.quickNote')"
              :aria-pressed="currentNoteType === 'quick'"
              title="灵感小记"
            >
              <Sparkles class="type-option-icon" />
            </button>
            <button
              type="button"
              class="type-option"
              :class="{ active: currentNoteType === 'article' }"
              @click="switchNoteType('article')"
              :aria-label="t('editor.article')"
              :aria-pressed="currentNoteType === 'article'"
              title="文章"
            >
              <FileText class="type-option-icon" />
            </button>
          </div>
        </transition>
      </div>

      <div class="header-actions">
        <button 
          class="nav-button action-button secondary-button" 
          @click="handleCancel"
          :aria-label="t('editor.cancel')"
        >
          <X class="nav-icon" />
          <span class="nav-text">{{ t('editor.cancel') }}</span>
        </button>

        <button 
          class="nav-button action-button primary-button" 
          @click="handleSave"
          :disabled="loading || !isFormValid"
          :aria-label="t('editor.save')"
        >
          <Check v-if="!loading" class="nav-icon" />
          <Loader2 v-else class="nav-icon spinning" />
          <span class="nav-text">{{ loading ? t('editor.saving') : t('editor.save') }}</span>
        </button>
      </div>
    </header>

    <!-- 主编辑区域 -->
    <main class="editor-main">
      <!-- 加载骨架屏 -->
      <transition name="skeleton">
        <div v-if="!mounted" class="skeleton-loader">
          <div class="skeleton-title"></div>
          <div class="skeleton-tags"></div>
          <div class="skeleton-content"></div>
        </div>
      </transition>

      <!-- 实际内容 -->
      <transition name="fade-in">
        <div v-show="mounted" class="editor-content-wrapper">
          <!-- 中央编辑区 -->
          <div class="editor-center-wrapper">
            <div class="editor-center editor-card">
              <form class="editor-form" @submit.prevent="handleSave">
                <!-- 标题输入 -->
                <div class="title-section" :class="[{ 'has-error': titleError, 'focused': titleFocused, 'dirty': titleDirty }, currentNoteType]">
                  <div class="title-icon-wrapper">
                    <Edit3 class="title-icon" />
                  </div>
                  <label for="title-input" class="visually-hidden">{{ t('editor.titleLabel') }}</label>
                  <input
                    id="title-input"
                    ref="titleInputRef"
                    v-model="formData.title"
                    type="text"
                    class="title-input"
                    :placeholder="t('editor.titlePlaceholder')"
                    :class="{ 'is-invalid': titleError }"
                    @blur="titleTouched = true; titleFocused = false"
                    @focus="titleFocused = true"
                    @input="titleDirty = true"
                    required
                    :aria-describedby="titleError ? 'title-error' : undefined"
                  />
                  <div class="title-footer">
                    <span class="char-count">{{ formData.title.length }}/200</span>
                  </div>
                  <div v-if="titleError" id="title-error" class="error-message title-error" role="alert">
                    <AlertCircle class="error-icon" />
                    {{ titleError }}
                  </div>
                </div>

                  <!-- 标签区域 -->
                   <div class="tags-section" :class="{ 'focused': tagFocused, 'has-error': tagsLimitWarning }">
                    <div class="tags-header">
                      <div class="tags-header-left">
                        <Hash class="tags-header-icon" />
                         <div class="tags-header-info">
                            <h3 id="tags-label" class="tags-header-title">{{ t('editor.tagsLabel') }}</h3>
                            <span class="tags-count" :class="{ 'near-limit': formData.tags.length >= tagsLimit - 2, 'at-limit': formData.tags.length >= tagsLimit }">
                              {{ formData.tags.length }}<span class="count-separator">/</span>{{ tagsLimit }}
                            </span>
                            <transition name="limit-warning">
                              <span v-if="tagsLimitWarning" class="tags-limit-warning-icon" aria-live="polite">
                                ⚠
                              </span>
                            </transition>
                         </div>
                      </div>
                      <button 
                         v-if="formData.tags.length > 0"
                         type="button"
                         class="clear-tags-button"
                         @click="confirmClearTags"
                         :title="t('editor.clearTags')"
                         :aria-label="t('editor.clearTags')"
                       >
                         <X class="clear-icon" />
                       </button>
                    </div>
                     
                    <!-- 标签输入区域 - 内联标签显示 -->
                    <div class="tags-input-container">
                      <div class="tags-input-wrapper">
                         <div class="tags-field-wrapper">
                           <div class="tags-display">
                             <transition-group name="tag-list" tag="span">
                               <span
                                v-for="(tag, index) in formData.tags"
                                :key="tag"
                                class="tag-chip"
                                :class="{ 
                                  'last-tag': index === formData.tags.length - 1,
                                  'shake-animation': shakingTag === tag 
                                }"
                                @click.right.prevent="showTagColorPicker(tag)"
                                @click.left.prevent="removeTag(tag)"
                              >
                                 <span class="tag-chip-text">#{{ tag }}</span>
                               </span>
                             </transition-group>
                             <input
                               id="tag-input"
                               ref="tagInputRef"
                               v-model="tagInput"
                               type="text"
                               class="tags-field"
                               :placeholder="formData.tags.length === 0 ? t('editor.tagsPlaceholder') : ''"
                               @keydown="handleTagKeydown"
                               @input="handleTagInputChange"
                               @focus="tagFocused = true"
                               @blur="handleTagBlur"
                               @paste="handleTagPaste"
                               aria-labelledby="tags-label"
                               aria-describedby="tags-count"
                             />
                           </div>
                           <button 
                             type="button" 
                             class="add-tag-button"
                             @click="handleAddTag"
                             :disabled="!canAddTag"
                             :title="canAddTag ? t('editor.tagsAdd') : `已达到${tagsLimit}个标签上限`"
                             :aria-label="canAddTag ? t('editor.tagsAdd') : `已达到${tagsLimit}个标签上限`"
                           >
                             <Plus class="add-icon" />
                           </button>
                         </div>
                         
                         <!-- 输入提示 -->
                         <div class="tags-input-hint" :class="{ 'focused': tagFocused }">
                           <span class="hint-text">
                             <template v-if="tagFocused">
                               <kbd>Enter</kbd> 添加 · <kbd>Esc</kbd> 取消 · <kbd>Backspace</kbd> 删除末尾
                             </template>
                             <template v-else>
                               <span class="hint-action">点击标签</span> · <span class="hint-shortcut">逗号或 Enter</span> 添加
                             </template>
                           </span>
                         </div>
                      </div>
                    </div>
                     
                    <!-- 标签建议 -->
                    <transition name="suggestions">
                      <div v-if="showTagSuggestions && tagSuggestions.length > 0 && tagFocused" class="tag-suggestions">
                         <div
                           v-for="(tag, index) in tagSuggestions"
                           :key="tag"
                           class="suggestion-item"
                           :class="{ 'highlighted': suggestionIndex === index, 'last-item': index === tagSuggestions.length - 1 }"
                           @click="selectTagSuggestion(tag)"
                           @mouseover="suggestionIndex = index"
                         >
                           <span class="suggestion-text">#{{ tag }}</span>
                           <span class="suggestion-shortcut">
                             <kbd v-if="index < 9">{{ index + 1 }}</kbd>
                           </span>
                         </div>
                      </div>
                    </transition>
                   </div>

                <!-- 内容编辑区 -->
                <div class="content-section" :class="[{ 'has-error': contentError, 'focused': contentFocused }, currentNoteType]">
                  <div class="content-header">
                    <FileText class="content-icon" />
                    <div class="content-header-info">
                       <span id="content-label" class="content-type">{{ t('editor.contentLabel') }}</span>
                      <span class="content-stats">{{ wordCount }} {{ t('editor.words') }} · {{ readTime }}</span>
                    </div>
                  </div>
                  <MarkdownEditor
                    v-if="currentNoteType === 'article'"
                    v-model="formData.content"
                    :placeholder="t('editor.contentPlaceholder')"
                    @blur="contentTouched = true"
                    class="markdown-editor-full"
                    :class="{ 'is-invalid': contentError }"
                  />
                   <textarea
                    v-else
                    id="content-input"
                    v-model="formData.content"
                    class="content-textarea"
                    :placeholder="t('editor.contentPlaceholder')"
                    :class="{ 'is-invalid': contentError }"
                    @blur="contentTouched = true"
                    @focus="handleContentFocus"
                    @input="handleContentChange"
                    @keydown="handleTextareaKeydown"
                    required
                    :aria-labelledby="'content-label'"
                    :aria-describedby="contentError ? 'content-error' : undefined"
                  />
                   <div v-if="contentError" id="content-error" class="error-message content-error" role="alert">
                    <AlertCircle class="error-icon" />
                    {{ contentError }}
                  </div>
                </div>
               </form>
             </div>
           </div>
         </div>
       </transition>
     </main>

    <!-- 确认对话框 -->
    <Teleport to="body">
      <Transition name="modal">
        <div v-if="showUnsavedDialog" class="modal-backdrop" @click="showUnsavedDialog = false">
          <div class="modal-content" @click.stop>
            <div class="modal-header">
              <AlertTriangle class="modal-icon" />
              <h3 class="modal-title">{{ t('editor.unsavedChanges') }}</h3>
            </div>
              <p class="modal-message">{{ t('editor.unsavedChangesMessage') }}</p>
              <div class="modal-actions">
                <button 
                  class="modal-button secondary" 
                  @click="showUnsavedDialog = false; emit('cancel')"
                >
                  {{ t('editor.discard') }}
                </button>
                <button 
                  class="modal-button primary" 
                  @click="showUnsavedDialog = false; handleSave()"
                >
                  {{ t('editor.save') }}
                </button>
              </div>
          </div>
        </div>
      </Transition>
    </Teleport>

    <!-- Toast 提示 -->
    <div v-if="toast.show" class="toast-notification" :class="toast.type">
      <CheckCircle v-if="toast.type === 'success'" class="toast-icon" />
      <X v-else-if="toast.type === 'error'" class="toast-icon" />
      <Info v-else class="toast-icon" />
      <span class="toast-message">{{ toast.message }}</span>
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, watch, onUnmounted, nextTick } from 'vue';
import { useI18n } from 'vue-i18n';
import { 
  ArrowLeft, X, Check, Loader2, Sparkles, FileText, 
  Hash, Plus, Info, CheckCircle, Edit3,
  AlertTriangle, AlertCircle
} from 'lucide-vue-next';
import { useTagsManagement } from '../composables/useTagsManagement';
import MarkdownEditor from './MarkdownEditor.vue';
import type { Note } from '../types';

interface Props {
  note: Note | null;
  mode: 'create' | 'edit';
  noteType?: 'quick' | 'article';
  showTypeSelector?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
  noteType: 'quick',
  showTypeSelector: true,
});

const emit = defineEmits<{
  save: [data: { title: string; content: string; tags: string[]; type: 'quick' | 'article' }];
  cancel: [];
}>();

const { t } = useI18n();

const currentNoteType = ref<'quick' | 'article'>(props.noteType);

const formData = ref({
  title: '',
  content: '',
  tags: [] as string[],
});

// Tags Management Integration
const tagsRef = computed({
  get: () => formData.value.tags,
  set: (val) => formData.value.tags = val
});

const {
  tagInput,
  showSuggestions: showTagSuggestions,
  suggestions: tagSuggestions,
  suggestionIndex,
  addTag: composableAddTag,
  removeTag: composableRemoveTag,
  clearAllTags,
  shakingTag,
  getTagColor,
  setTagColor,
  tagsLimitWarning,
  sortAsc: sortTagsAsc
} = useTagsManagement(tagsRef);

const titleInputRef = ref<HTMLInputElement | null>(null);
const tagInputRef = ref<HTMLInputElement | null>(null);
const loading = ref(false);
const autoSaving = ref(false);
const titleTouched = ref(false);
const contentTouched = ref(false);
const titleFocused = ref(false);
const tagFocused = ref(false);
const contentFocused = ref(false);
const mounted = ref(false);

const lastSaved = ref<string>('');
const autoSaveTimer = ref<number | null>(null);
const justSaved = ref(false);
const contentChanged = ref(false);
const tagsChanged = ref(false);
const titleDirty = ref(false);
const showUnsavedDialog = ref(false);
const showColorPicker = ref(false);
const selectedTagColor = ref('');
const selectedTagForColor = ref<string | null>(null);
const pendingChanges = ref(false);
const saveInProgress = ref(false);
const lastAutoSaveTime = ref(0);

const toast = ref({
  show: false,
  message: '',
  type: 'success' as 'success' | 'error' | 'info',
});

const originalData = ref({
  title: '',
  content: '',
  tags: [] as string[],
});

const tagColorPalette = [
  '#fbbf24', '#f59e0b', '#d97706', '#b45309',
  '#8b5cf6', '#7c3aed', '#6d28d9', '#5b21b6',
  '#ec4899', '#db2777', '#be185d', '#9d174d',
  '#06b6d4', '#0891b2', '#0e7490', '#155e75',
  '#10b981', '#059669', '#047857', '#065f46',
  '#f87171', '#ef4444', '#dc2626', '#b91c1c'
];

const wordCount = computed(() => {
  if (!formData.value.content) return 0;
  return formData.value.content.trim().split(/\s+/).filter(w => w.length > 0).length;
});

const readTime = computed(() => {
  const wpm = 200;
  const minutes = Math.ceil(wordCount.value / wpm);
  return minutes > 0 ? `${minutes} ${t('editor.minutes')}` : t('editor.lessThanMinute');
});

const tagsLimit = 10;
const canAddTag = computed(() => {
  return tagInput.value.trim() && formData.value.tags.length < tagsLimit;
});

const titleError = computed(() => {
  if (!titleTouched.value) return '';
  if (!formData.value.title || formData.value.title.trim().length === 0) {
    return t('editor.titleRequired');
  }
  if (formData.value.title.length < 2) {
    return t('editor.titleTooShort');
  }
  if (formData.value.title.length > 200) {
    return t('editor.titleTooLong');
  }
  return '';
});

const contentError = computed(() => {
  if (!contentTouched.value) return '';
  if (!formData.value.content || formData.value.content.trim().length === 0) {
    return t('editor.contentRequired');
  }
  if (formData.value.content.length < 5) {
    return t('editor.contentTooShort');
  }
  return '';
});

const isFormValid = computed(() => {
  return !titleError.value && !contentError.value;
});

const hasUnsavedChanges = computed(() => {
  return (
    formData.value.title !== originalData.value.title ||
    formData.value.content !== originalData.value.content ||
    JSON.stringify(formData.value.tags) !== JSON.stringify(originalData.value.tags)
  );
});

watch(() => props.noteType, (newType) => {
  currentNoteType.value = newType;
});

watch(() => props.note, (newNote) => {
  if (newNote) {
    currentNoteType.value = (newNote.type as 'quick' | 'article') || 'quick';
    formData.value = {
      title: newNote.title,
      content: newNote.content,
      tags: newNote.tags || [],
    };
    originalData.value = { ...formData.value };
  }
}, { immediate: true });

watch(() => formData.value.title, () => {
  pendingChanges.value = true;
  triggerAutoSave();
});

watch(() => formData.value.content, () => {
  contentChanged.value = formData.value.content !== originalData.value.content;
  pendingChanges.value = true;
  triggerAutoSave();
});

watch(() => formData.value.tags, () => {
  tagsChanged.value = JSON.stringify(formData.value.tags) !== JSON.stringify(originalData.value.tags);
  pendingChanges.value = true;
  triggerAutoSave();
});

watch(showUnsavedDialog, (newValue) => {
  if (newValue) {
    document.body.style.overflow = 'hidden';
  } else {
    document.body.style.overflow = '';
  }
});

function formatDate(dateStr?: string) {
  if (!dateStr) return '-';
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
  toast.value = { show: true, message, type };
  setTimeout(() => {
    toast.value.show = false;
  }, 3000);
}

function triggerAutoSave() {
  // 只在编辑模式下触发自动保存
  if (props.mode !== 'edit') {
    return;
  }
  
  // 如果已经在保存中，不重复触发
  if (saveInProgress.value) {
    return;
  }
  
  if (autoSaveTimer.value) {
    clearTimeout(autoSaveTimer.value);
  }
  
  // 动态调整保存延迟：如果是首次保存或长时间未保存，缩短延迟
  const timeSinceLastSave = Date.now() - lastAutoSaveTime.value;
  const saveDelay = timeSinceLastSave > 60000 ? 1000 : 3000;
  
  autoSaveTimer.value = window.setTimeout(async () => {
    if (isFormValid.value && !saveInProgress.value) {
      saveInProgress.value = true;
      autoSaving.value = true;
      lastAutoSaveTime.value = Date.now();
      
      const savedData = {
        title: formData.value.title,
        content: formData.value.content,
        tags: formData.value.tags,
        type: currentNoteType.value,
      };
      
      try {
        emit('save', savedData);
        
        // 模拟API调用延迟
        await new Promise(resolve => setTimeout(resolve, 300));
        
        autoSaving.value = false;
        pendingChanges.value = false;
        lastSaved.value = new Date().toLocaleTimeString('zh-CN', {
          hour: '2-digit',
          minute: '2-digit'
        });
        justSaved.value = true;
        
        setTimeout(() => {
          justSaved.value = false;
        }, 2000);
        
        // 更新原始数据，避免误报未保存更改
        originalData.value = { ...formData.value };
      } catch (error) {
        console.error('自动保存失败:', error);
        autoSaving.value = false;
        showToast('保存失败', 'error');
      } finally {
        saveInProgress.value = false;
      }
    }
  }, saveDelay);
}

function switchNoteType(type: 'quick' | 'article') {
  currentNoteType.value = type;
  nextTick(() => {
    titleInputRef.value?.focus();
  });
}

function handleBeforeUnload(e: BeforeUnloadEvent) {
  if (hasUnsavedChanges.value) {
    e.preventDefault();
    e.returnValue = '';
  }
}

function handleKeydown(e: KeyboardEvent) {
  const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
  const modifierKey = isMac ? e.metaKey : e.ctrlKey;
  const activeElement = document.activeElement;
  const isTagInput = activeElement === tagInputRef.value;
  const isTitleInput = activeElement === titleInputRef.value;
  const isContentInput = activeElement === document.getElementById('content-input');
  const isMarkdownEditor = activeElement?.closest('.markdown-editor-content');

  // 保存快捷键 (Cmd/Ctrl + S)
  if (modifierKey && e.key === 's') {
    e.preventDefault();
    if (isFormValid.value) {
      handleSave();
    }
  }
  
  // 取消/关闭 (Escape)
  if (e.key === 'Escape') {
    if (showColorPicker.value) {
      showColorPicker.value = false;
    } else if (showUnsavedDialog.value) {
      showUnsavedDialog.value = false;
    } else if (tagFocused.value) {
      tagInput.value = '';
      showTagSuggestions.value = false;
      tagFocused.value = false;
    } else if (!loading.value) {
      handleCancel();
    }
  }
  
  // 快速添加标签 (逗号)
  if (e.key === ',' && document.activeElement !== tagInputRef.value) {
    e.preventDefault();
    tagInputRef.value?.focus();
  }
  
  // 切换笔记类型 (T)
  if ((e.altKey || e.metaKey) && e.key === 't' && props.mode === 'create') {
    e.preventDefault();
    switchNoteType(currentNoteType.value === 'quick' ? 'article' : 'quick');
  }
  
  // 打开颜色选择器 (Cmd/Ctrl + K)
  if (modifierKey && e.key === 'k' && formData.value.tags.length > 0) {
    e.preventDefault();
    showColorPicker.value = !showColorPicker.value;
    if (showColorPicker.value) {
      showToast('标签颜色选择器已打开，使用方向键和回车选择颜色', 'info');
    }
  }
  
  // 标签建议导航
  if (showTagSuggestions.value && tagFocused.value) {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      suggestionIndex.value = Math.min(suggestionIndex.value + 1, tagSuggestions.value.length - 1);
      scrollToSuggestion(suggestionIndex.value + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      suggestionIndex.value = Math.max(suggestionIndex.value - 1, -1);
      scrollToSuggestion(suggestionIndex.value - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (suggestionIndex.value >= 0) {
        selectTagSuggestion(tagSuggestions.value[suggestionIndex.value]);
      } else if (tagInput.value.trim()) {
        addTag(tagInput.value.trim());
        tagInput.value = '';
      }
    } else if (e.key === 'Escape') {
      tagInput.value = '';
      showTagSuggestions.value = false;
      suggestionIndex.value = -1;
    } else if (e.key === 'Tab') {
      e.preventDefault();
      if (suggestionIndex.value >= 0) {
        selectTagSuggestion(tagSuggestions.value[suggestionIndex.value]);
      }
    }
  }
  
   // 颜色选择器导航
  if (showColorPicker.value) {
    handleColorPickerKeydown(e);
  }
   
   // 表单字段导航
  if (e.key === 'Tab') {
    // 标签输入框特殊处理
    if (isTagInput && !tagInput.value.trim()) {
      e.preventDefault();
      if (e.shiftKey) {
        titleInputRef.value?.focus();
      } else {
        titleInputRef.value?.focus();
      }
      return;
    }

    // 如果在标签输入框内按 Tab，聚焦到标题输入框
    if (isTagInput) {
      e.preventDefault();
      if (e.shiftKey) {
        titleInputRef.value?.focus();
      } else {
        titleInputRef.value?.focus();
      }
      return;
    }

    // 如果在 Markdown 编辑器内，不处理
    if (isMarkdownEditor) {
      return;
    }

    // 标题和内容输入框之间的导航
    if (isTitleInput || isContentInput) {
      e.preventDefault();
      if (e.shiftKey) {
        // Shift+Tab 聚焦到标签输入
        tagInputRef.value?.focus();
      } else {
        // Tab 聚焦到下一个（标题或内容）
        if (isTitleInput) {
          const nextInput = document.getElementById('content-input') || document.getElementById('content-textarea') || tagInputRef.value;
          nextInput?.focus();
        } else {
          tagInputRef.value?.focus();
        }
      }
      return;
    }
  }

  // 如果在标签输入框内按 Backspace，删除最后一个标签
  if (isTagInput && e.key === 'Backspace') {
    if (!tagInput.value.trim() && formData.value.tags.length > 0) {
      e.preventDefault();
      removeTag(formData.value.tags[formData.value.tags.length - 1]);
      return;
    }
  }

  // 快捷键：快速添加标签（Alt + 标点 + T）
  if ((e.altKey || e.metaKey) && e.key === 't' && props.mode === 'create') {
    e.preventDefault();
    switchNoteType(currentNoteType.value === 'quick' ? 'article' : 'quick');
    showToast(`切换为 ${currentNoteType.value === 'quick' ? '文章' : '灵感小记'}模式`, 'info');
  }

  // 快捷键：重复上一个标签（Alt + 标点 + U）
  if ((e.altKey || e.metaKey) && e.key === 'u' && props.mode === 'create') {
    e.preventDefault();
    duplicateLastTag();
  }
}

function scrollToSuggestion(index: number) {
  const suggestions = document.querySelectorAll('.suggestion-item');
  if (suggestions[index]) {
    suggestions[index].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }
}

function handleColorPickerKeydown(e: KeyboardEvent) {
  if (['ArrowRight', 'ArrowLeft', 'ArrowUp', 'ArrowDown', 'Enter', 'Escape'].includes(e.key)) {
    e.preventDefault();
    
    if (e.key === 'Escape') {
      showColorPicker.value = false;
    } else if (e.key === 'Enter') {
      applyColorToSelectedTags(selectedTagColor.value);
      showColorPicker.value = false;
      showToast('标签颜色已应用', 'success');
    } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      const currentIndex = tagColorPalette.indexOf(selectedTagColor.value);
      const nextIndex = (currentIndex + 1) % tagColorPalette.length;
      selectedTagColor.value = tagColorPalette[nextIndex];
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      const currentIndex = tagColorPalette.indexOf(selectedTagColor.value);
      const prevIndex = (currentIndex - 1 + tagColorPalette.length) % tagColorPalette.length;
      selectedTagColor.value = tagColorPalette[prevIndex];
    }
  }
}

function focusFirstInvalidField() {
  if (titleError.value) {
    titleInputRef.value?.focus();
    return;
  }
  if (contentError.value) {
    // For quick notes, focus the textarea
    if (currentNoteType.value === 'quick') {
      const textarea = document.getElementById('content-input') as HTMLTextAreaElement | null;
      textarea?.focus();
    }
    // For articles, focus is handled by MarkdownEditor component internally
  }
}

async function handleSave() {
  titleTouched.value = true;
  contentTouched.value = true;

  if (!isFormValid.value) {
    focusFirstInvalidField();
    return;
  }

  if (loading.value || saveInProgress.value) {
    return;
  }

  loading.value = true;
  saveInProgress.value = true;
  
  try {
    const savedData = {
      title: formData.value.title,
      content: formData.value.content,
      tags: formData.value.tags,
      type: currentNoteType.value,
    };
    
    emit('save', savedData);
    
    // 模拟API调用延迟
    await new Promise(resolve => setTimeout(resolve, 300));
    
    lastSaved.value = new Date().toLocaleTimeString('zh-CN', {
      hour: '2-digit',
      minute: '2-digit'
    });
    
    pendingChanges.value = false;
    lastAutoSaveTime.value = Date.now();
    
    // 更新原始数据，避免误报未保存更改
    originalData.value = { ...formData.value };
  } catch (error) {
    console.error('保存失败:', error);
    showToast('保存失败', 'error');
  } finally {
    loading.value = false;
    saveInProgress.value = false;
  }
}

function handleCancel() {
  if (hasUnsavedChanges.value && props.mode === 'edit') {
    showUnsavedDialog.value = true;
  } else {
    emit('cancel');
  }
}

function handleTagKeydown(event: KeyboardEvent) {
  if (event.key === 'Enter' && tagInput.value.trim()) {
    event.preventDefault();
    addTag(tagInput.value.trim());
    tagInput.value = '';
    showTagSuggestions.value = false;
  } else if (event.key === ',' && tagInput.value.trim()) {
    event.preventDefault();
    addTag(tagInput.value.trim());
    tagInput.value = '';
    showTagSuggestions.value = false;
  } else if (event.key === 'Backspace' && !tagInput.value && formData.value.tags.length > 0) {
    formData.value.tags.pop();
  }
}

function handleTagInputChange() {
  // 由 watch 处理
}

function handleContentChange() {
  // 内容变化处理
}

function handleContentFocus() {
  contentFocused.value = true;
}

function handleTextareaKeydown(event: KeyboardEvent) {
  if (event.key === 'Tab') {
    event.preventDefault();
    const textarea = event.target as HTMLTextAreaElement;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const value = formData.value.content;
    formData.value.content = value.substring(0, start) + '  ' + value.substring(end);
    nextTick(() => {
      textarea.selectionStart = textarea.selectionEnd = start + 2;
    });
  }
}

function handleAddTag() {
  if (tagInput.value.trim()) {
    addTag(tagInput.value.trim());
  }
}

function addTag(tag: string) {
  const result = composableAddTag(tag);
  if (result === 'added') {
    showToast(t('editor.tagAdded', { tag }), 'success');
    nextTick(() => tagInputRef.value?.focus());
  } else if (result === 'duplicate') {
    showToast('标签已存在', 'error');
    tagInputRef.value?.focus();
  } else if (result === 'limit') {
    showToast(t('editor.tagsLimitExceeded', { limit: tagsLimit }), 'error');
    tagInputRef.value?.focus();
  }
}

function removeTag(tag: string) {
  if (composableRemoveTag(tag)) {
    showToast(t('editor.tagRemoved', { tag }), 'info');
    if (formData.value.tags.length > 0) {
      nextTick(() => tagInputRef.value?.focus());
    }
  }
}

function confirmClearTags() {
  if (formData.value.tags.length === 0) return;
  clearAllTags();
  showToast(t('editor.tagsCleared'), 'success');
  tagInputRef.value?.focus();
}

function handleTagBlur() {
  setTimeout(() => {
    showTagSuggestions.value = false;
    suggestionIndex.value = -1;
  }, 150);
}

function handleTagPaste(event: ClipboardEvent) {
  event.preventDefault();

  const clipboardData = (event as any).clipboardData;
  const clipboard = clipboardData || (window as any).clipboardData;
  const pasteData = clipboard
    ? clipboard.getData('text/plain')
    : null;

  if (!pasteData) return;

  const pasteText = pasteData ? pasteData.getData('text/plain') || '' : '';
  const tags = pasteText
    .split(/[,，\n\r]+/)
    .map((tag: string) => tag.trim())
    .filter((tag: string) => tag && !formData.value.tags.includes(tag))
    .slice(0, tagsLimit - formData.value.tags.length);

  if (tags.length > 0) {
    tags.forEach((tag: string) => {
      composableAddTag(tag);
    });
    tagInput.value = '';
    showToast(`已添加 ${tags.length} 个标签`, 'success');
  }
}

function selectTagSuggestion(tag: string) {
  addTag(tag);
  tagInput.value = '';
  showTagSuggestions.value = false;
  suggestionIndex.value = -1;
}

function duplicateLastTag() {
  if (formData.value.tags.length > 0) {
    const lastTag = formData.value.tags[formData.value.tags.length - 1];
    tagInput.value = lastTag;
    tagInputRef.value?.focus();
  }
}

function showTagColorPicker(tag: string) {
  selectedTagForColor.value = tag;
  selectedTagColor.value = getTagColor(tag);
  showColorPicker.value = true;
}

function applyColorToSelectedTags(color: string) {
  if (selectedTagForColor.value) {
    setTagColor(selectedTagForColor.value, color);
    selectedTagForColor.value = null;
    showToast('标签颜色已更新', 'success');
  } else {
    formData.value.tags.forEach(tag => {
      setTagColor(tag, color);
    });
    showToast('所有标签颜色已更新', 'success');
  }
}

onMounted(() => {
  setTimeout(() => {
    titleInputRef.value?.focus();
    mounted.value = true;
  }, 100);
  window.addEventListener('keydown', handleKeydown);
  window.addEventListener('beforeunload', handleBeforeUnload);
});

onUnmounted(() => {
  window.removeEventListener('keydown', handleKeydown);
  window.removeEventListener('beforeunload', handleBeforeUnload);
  if (autoSaveTimer.value) {
    clearTimeout(autoSaveTimer.value);
  }
  document.body.style.overflow = '';
});
</script>

